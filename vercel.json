{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/build-manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/about",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/contact",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/contact/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/gallery",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/gallery/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/portal",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/portal/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/admin.ts": {
      "maxDuration": 60
    },
    "api/contact.ts": {
      "maxDuration": 30
    },
    "api/cron.ts": {
      "maxDuration": 60
    },
    "api/inbox.ts": {
      "maxDuration": 60
    },
    "api/portal.ts": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/portraits",
      "destination": "/gallery/portraits",
      "permanent": true
    },
    {
      "source": "/maternity",
      "destination": "/gallery/maternity",
      "permanent": true
    },
    {
      "source": "/family",
      "destination": "/gallery/family",
      "permanent": true
    },
    {
      "source": "/weddings",
      "destination": "/gallery/weddings",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/portal/:action",
      "destination": "/api/portal?action=:action"
    },
    {
      "source": "/api/admin/:action",
      "destination": "/api/admin?action=:action"
    },
    {
      "source": "/api/cron/:job",
      "destination": "/api/cron?job=:job"
    },
    {
      "source": "/api/inbox/:action",
      "destination": "/api/inbox?action=:action"
    },
    {
      "source": "/api/journal/:action",
      "destination": "/api/journal?action=:action"
    },
    {
      "source": "/api/gallery/:action",
      "destination": "/api/gallery?action=:action"
    },
    {
      "source": "/photo/:category/:photoId",
      "destination": "/photo/:category/:photoId.html"
    },
    {
      "source": "/gallery/:category(portraits|weddings|family|maternity)",
      "destination": "/gallery/:category.html"
    },
    {
      "source": "/journal",
      "destination": "/journal.html"
    },
    {
      "source": "/journal/:slug",
      "destination": "/journal/:slug.html"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/instagram-check",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/gallery-sync",
      "schedule": "0 2 * * *"
    }
  ]
}
